# Normalise line endings; keep the repo UTF-8 and consistent across OSes.
* text=auto eol=lf

# Explicit text types (Korean content is UTF-8; do not let tools mangle it)
*.md        text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.txt       text eol=lf
*.toml      text eol=lf

# Shell scripts must stay LF even on Windows checkouts
*.sh        text eol=lf

# Windows batch files need CRLF
*.bat       text eol=crlf

# Binary assets — never touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.mp3       binary
*.wav       binary
*.woff      binary
*.woff2     binary

# Linguist / diff hints
docs/**     linguist-documentation
